# Environment Configuration for Air Quality & Public Health Early-Warning System
# Course: 21MDS56 - Big Data Computing Laboratory

# Ingestion Mode: 'synthetic' (works 100% offline) or 'live'
DATA_MODE=synthetic

# External API Credentials (Optional when DATA_MODE=synthetic)
OPENAQ_API_KEY=
OPENWEATHER_API_KEY=

# MongoDB Storage
MONGO_URI=mongodb://localhost:27017/
MONGO_DB=air_quality_ews

# Apache Hive Connection
HIVE_HOST=127.0.0.1
HIVE_PORT=10000
HIVE_USER=mithra
HIVE_DB=default

# Apache Hadoop HDFS Base URI
HDFS_DEFAULT_FS=hdfs://localhost:9000

# Web Application
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False
SECRET_KEY=cit_21mds56_bigdata_secret_key_2026
